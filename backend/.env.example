# Rename this file to .env and fill in your values.
# The backend runs in mock-data mode when API keys are left empty.

# OpenWeatherMap — free tier at https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key_here

# NewsAPI — free developer tier at https://newsapi.org
NEWS_API_KEY=your_newsapi_key_here

# JWT secret — change this to a long random string in production
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me-in-production
